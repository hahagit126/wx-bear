<view class="page">

<!-- 顶部 -->
<view class="header">
  <view class="back" bindtap="goBack">‹</view>
  <view class="header-title">确认订单</view>
  <view class="header-placeholder"></view>
</view>

<!-- 配送信息 -->
<view class="address-card">

  <view class="address-icon">
    {{deliveryType === '配送' ? '📍' : '🏪'}}
  </view>

  <view class="address-info">

    <view class="address-title">
      配送信息
    </view>

    <view class="delivery-options">

      <view
        class="delivery-option {{deliveryType === '配送' ? 'delivery-active' : ''}}"
        data-type="配送"
        bindtap="selectDelivery"
      >
        校园配送
      </view>

      <view
        class="delivery-option {{deliveryType === '到店自取' ? 'delivery-active' : ''}}"
        data-type="到店自取"
        bindtap="selectDelivery"
      >
        到店自取
      </view>

    </view>

    <view class="address-text">
      {{deliveryType === '配送' ? '校园配送' : '到店自取'}}
    </view>

    <view class="address-tip">
      {{deliveryType === '配送'
        ? '请确认收货地址后提交订单'
        : '请到店内出示订单取餐'}}
    </view>

  </view>

  <view class="address-arrow">
    ›
  </view>

</view>


<!-- 商品 -->
<view class="section">

  <view class="section-title">
    <text>商品清单</text>
    <text class="count">{{totalCount}}件</text>
  </view>

  <view
    class="order-item"
    wx:for="{{orderList}}"
    wx:key="cartId"
  >

    <view class="item-emoji">
      {{item.emoji}}
    </view>

    <view class="item-info">

      <view class="item-name">
        {{item.name}}
      </view>

      <view class="item-desc">
        {{item.desc}}
      </view>

      <view class="item-bottom">

        <text class="item-price">
          ¥{{item.price}}
        </text>

        <text class="item-quantity">
          × {{item.quantity}}
        </text>

      </view>

    </view>

    <view class="item-subtotal">
      ¥{{item.subtotal}}
    </view>

  </view>


  <!-- 空购物车 -->
  <view
    class="empty"
    wx:if="{{orderList.length === 0}}"
  >
    <view class="empty-icon">🛒</view>
    <view class="empty-text">购物车是空的</view>
  </view>

</view>


<!-- 价格明细 -->
<view class="price-card">

  <view class="price-row">
    <text>商品小计</text>
    <text>¥{{totalPrice}}</text>
  </view>

  <view class="price-row">
    <text>配送费</text>

    <text>
      {{deliveryFee === 0 ? '免配送费' : '¥' + deliveryFee}}
    </text>
  </view>

  <view class="divider"></view>

  <view class="total-row">
    <text>合计</text>

    <text class="total-price">
      ¥{{finalPrice}}
    </text>
  </view>

</view>


<!-- 底部提交 -->
<view class="bottom-bar">

  <view class="bottom-price">

    <text class="bottom-label">
      应付
    </text>

    <text class="bottom-total">
      ¥{{finalPrice}}
    </text>

  </view>

  <view
    class="submit-btn"
    bindtap="submitOrder"
  >
    提交订单
  </view>

</view>

</view>