.page {
  min-height: 100vh;
  background: #fff8f0;
  box-sizing: border-box;
  padding-bottom: 150rpx;
}

/* 顶部 */
.header {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  box-sizing: border-box;
  background: #fff8f0;
}

.back {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  font-size: 60rpx;
  color: #6b4f3a;
  line-height: 70rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #6b4f3a;
}

.header-placeholder {
  width: 70rpx;
}

/* 配送信息 */
.address-card {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(107, 79, 58, 0.06);
}

.address-icon {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  background: #fff2df;
  border-radius: 50%;
  margin-right: 22rpx;
}

.address-info {
  flex: 1;
}

.address-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #604735;
  margin-bottom: 8rpx;
}

.address-text {
  font-size: 27rpx;
  color: #7b6250;
}

.address-tip {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #a28c7a;
}

.address-arrow {
  font-size: 40rpx;
  color: #b8a494;
}

/* 区块 */
.section {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(107, 79, 58, 0.06);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f3ebe4;
  font-size: 32rpx;
  font-weight: bold;
  color: #604735;
}

.count {
  font-size: 25rpx;
  font-weight: normal;
  color: #a28c7a;
}

/* 商品 */
.order-item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f3ebe4;
}

.order-item:last-child {
  border-bottom: none;
}

.item-emoji {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff7ed;
  border-radius: 20rpx;
  font-size: 52rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.item-name {
  font-size: 29rpx;
  font-weight: bold;
  color: #604735;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #a28c7a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-bottom {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.item-price {
  font-size: 26rpx;
  color: #b66a45;
}

.item-quantity {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #998273;
}

.item-subtotal {
  margin-left: 15rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #604735;
}

/* 空购物车 */
.empty {
  padding: 70rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 70rpx;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #a28c7a;
}

/* 价格 */
.price-card {
  margin: 20rpx 30rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(107, 79, 58, 0.06);
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  font-size: 28rpx;
  color: #806958;
}

.divider {
  height: 1rpx;
  margin: 20rpx 0;
  background: #f3ebe4;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #604735;
}

.total-price {
  font-size: 40rpx;
  color: #b66a45;
}

/* 底部 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 125rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -6rpx 20rpx rgba(107, 79, 58, 0.08);
  z-index: 100;
}

.bottom-price {
  display: flex;
  align-items: baseline;
}

.bottom-label {
  font-size: 26rpx;
  color: #806958;
}

.bottom-total {
  margin-left: 10rpx;
  font-size: 42rpx;
  font-weight: bold;
  color: #b66a45;
}

.submit-btn {
  min-width: 230rpx;
  height: 82rpx;
  padding: 0 35rpx;
  border-radius: 45rpx;
  background: #6b4f3a;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: bold;
  box-sizing: border-box;
}

/* ========================= */
/* 配送方式选择 */
/* ========================= */

.delivery-options {
  display: flex;
  align-items: center;
  margin: 14rpx 0 12rpx;
}

.delivery-option {
  padding: 10rpx 24rpx;
  margin-right: 16rpx;

  border: 1rpx solid #e8ddd4;
  border-radius: 30rpx;

  font-size: 24rpx;
  color: #806958;
  background: #ffffff;

  box-sizing: border-box;
}

.delivery-active {
  color: #ffffff;
  background: #6b4f3a;
  border-color: #6b4f3a;
}