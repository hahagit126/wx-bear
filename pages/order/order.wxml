
<!-- pages/order/order.wxml -->

<view class="page">

  <!-- 页面标题 -->
  <view class="page-header">

<view class="back" bindtap="goBack">
  ←
</view>

<view class="header-content">

  <view class="header-title">
    订单记录
  </view>

  <view class="header-subtitle">
    查看你的历史订单
  </view>

</view>

<view
  wx:if="{{orders.length > 0}}"
  class="clear-button"
  catchtap="clearOrders"
>
  清空
</view>

</view>


  <!-- 有订单 -->
  <view
    wx:if="{{orders.length > 0}}"
    class="order-list"
  >

    <block
      wx:for="{{orders}}"
      wx:key="id"
      wx:for-index="index"
    >

      <!-- 订单卡片 -->
      <view
        class="order-card"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >

        <!-- 订单顶部 -->
        <view class="order-top">

          <view class="order-number">
            订单号：{{item.id}}
          </view>

          <view class="order-status status-{{item.status}}">
            {{item.statusText}}
          </view>

        </view>


        <!-- 分割线 -->
        <view class="divider"></view>

        <!-- 订单进度 -->
<view
  wx:if="{{item.status !== 'cancelled'}}"
  class="progress"
>

  <view class="progress-item">

    <view
      class="progress-dot {{item.statusStep >= 1 ? 'progress-active' : ''}}"
    ></view>

    <view class="progress-label">
      待处理
    </view>

  </view>


  <view
    class="progress-line {{item.statusStep >= 2 ? 'progress-line-active' : ''}}"
  ></view>


  <view class="progress-item">

    <view
      class="progress-dot {{item.statusStep >= 2 ? 'progress-active' : ''}}"
    ></view>

    <view class="progress-label">
      制作中
    </view>

  </view>


  <view
    class="progress-line {{item.statusStep >= 3 ? 'progress-line-active' : ''}}"
  ></view>


  <view class="progress-item">

    <view
      class="progress-dot {{item.statusStep >= 3 ? 'progress-active' : ''}}"
    ></view>

    <view class="progress-label">
      待取餐
    </view>

  </view>


  <view
    class="progress-line {{item.statusStep >= 4 ? 'progress-line-active' : ''}}"
  ></view>


  <view class="progress-item">

    <view
      class="progress-dot {{item.statusStep >= 4 ? 'progress-active' : ''}}"
    ></view>

    <view class="progress-label">
      配送中
    </view>

  </view>


  <view
    class="progress-line {{item.statusStep >= 5 ? 'progress-line-active' : ''}}"
  ></view>


  <view class="progress-item">

    <view
      class="progress-dot {{item.statusStep >= 5 ? 'progress-active' : ''}}"
    ></view>

    <view class="progress-label">
      已完成
    </view>

  </view>

</view>


<!-- 已取消 -->
<view
  wx:if="{{item.status === 'cancelled'}}"
  class="cancelled-tip"
>
  订单已取消
</view>


        <!-- 商品区域 -->
        <view class="product-area">

          <!-- SVG订单图标 -->
          <view class="product-icon">

            <image
              class="order-svg"
              src="/pages/order/order.svg"
              mode="aspectFit"
            />

          </view>


          <!-- 商品信息 -->
          <view class="product-info">

            <view class="product-name">
              {{item.product}}
            </view>

            <view class="product-detail">
              {{item.detail}}
            </view>

            <view class="product-time">
              {{item.time}}
            </view>

          </view>


          <!-- 价格 -->
          <view class="price-area">

            <view class="price">
              ¥{{item.finalPrice}}
            </view>

            <view class="quantity">
              共{{item.totalCount}}件
            </view>

          </view>

        </view>


        <!-- 底部按钮 -->
        <view class="order-bottom">

          <view class="bottom-text">
            {{item.statusText}}
          </view>

          <view class="bottom-buttons">

            <!-- 删除订单 -->
            <view
              class="delete-button"
              data-id="{{item.id}}"
              catchtap="deleteOrder"
            >
              删除订单
            </view>

            <!-- 再来一单 -->
            <view
              class="order-button"
              data-id="{{item.id}}"
              catchtap="buyAgain"
            >
              再来一单
            </view>

          </view>

        </view>

      </view>

    </block>

  </view>


  <!-- 没有订单 -->
  <view
    wx:else
    class="empty"
  >

    <image
      class="empty-svg"
      src="/pages/order/order.svg"
      mode="aspectFit"
    />

    <view class="empty-title">
      暂无订单
    </view>

    <view class="empty-desc">
      还没有提交过订单哦~
    </view>

  </view>

</view>

