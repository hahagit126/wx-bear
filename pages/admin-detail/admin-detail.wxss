page {
  background: #f7f7f7;
}

.page {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 50rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.header {
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #222222;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222222;
}

.placeholder {
  width: 70rpx;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  margin-bottom: 22rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eeeeee;
  font-size: 30rpx;
  font-weight: 700;
  color: #222222;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 25rpx;
  color: #999999;
}

.value {
  max-width: 65%;
  font-size: 25rpx;
  color: #444444;
  text-align: right;
  word-break: break-all;
}

.status {
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  font-size: 23rpx;
}

.status-pending {
  color: #e65100;
  background: #fff3e0;
}

.status-making {
  color: #6b4f3a;
  background: #f5eee8;
}

.status-ready {
  color: #1565c0;
  background: #e3f2fd;
}

.status-delivering {
  color: #7b1fa2;
  background: #f3e5f5;
}

.status-completed {
  color: #2e7d32;
  background: #e8f5e9;
}

.status-cancelled {
  color: #c62828;
  background: #ffebee;
}


/* 当前状态 */

.current-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.current-status-label {
  font-size: 26rpx;
  color: #777777;
}


/* 状态按钮 */

.status-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.status-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 24rpx;
  border: 1rpx solid #dddddd;
  border-radius: 30rpx;
  background: #ffffff;
  font-size: 23rpx;
  color: #555555;
  box-sizing: border-box;
}

.status-button:active {
  opacity: 0.7;
}

.current-status {
  color: #ffffff;
  background: #6b4f3a;
  border-color: #6b4f3a;
  font-weight: 600;
}

.current-cancel-status {
  color: #ffffff;
  background: #c62828;
  border-color: #c62828;
  font-weight: 600;
}


/* 商品 */

.item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.item:last-child {
  border-bottom: none;
}

.item-icon {
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #faf7f3;
  border-radius: 18rpx;
  font-size: 44rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-desc {
  margin-top: 7rpx;
  font-size: 22rpx;
  color: #999999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-bottom {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666666;
}

.quantity {
  margin-left: 18rpx;
  color: #999999;
}

.item-subtotal {
  margin-left: 15rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #333333;
}

.empty-items {
  padding: 40rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #999999;
}


/* 金额 */

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 0;
  font-size: 26rpx;
  color: #777777;
}

.divider {
  height: 1rpx;
  margin: 18rpx 0;
  background: #eeeeee;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.total-price {
  font-size: 40rpx;
  color: #6b4f3a;
}

.count-tip {
  padding: 30rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: #999999;
}