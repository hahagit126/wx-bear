<!-- pages/admin-detail/admin-detail.wxml -->

<view class="page">

<view class="header">

  <view
    class="back"
    bindtap="goBack"
  >
    ←
  </view>

  <view class="header-title">
    订单详情
  </view>

  <view class="placeholder"></view>

</view>


<!-- 订单信息 -->

<view class="card">

  <view class="card-title">
    订单信息
  </view>

  <view class="info-row">
    <text class="label">订单号</text>
    <text class="value">{{order.id}}</text>
  </view>

  <view class="info-row">
    <text class="label">下单时间</text>
    <text class="value">{{order.time}}</text>
  </view>

  <view class="info-row">
    <text class="label">订单状态</text>

    <text class="status status-{{order.status}}">
      {{order.statusText}}
    </text>

  </view>

  <view class="info-row">
    <text class="label">配送方式</text>
    <text class="value">{{order.deliveryType}}</text>
  </view>

  <view class="info-row">
    <text class="label">配送信息</text>
    <text class="value">{{order.deliveryInfo}}</text>
  </view>

</view>


<!-- 修改订单状态 -->

<view class="card">

  <view class="card-title">
    修改订单状态
  </view>

  <view class="current-status-row">

    <text class="current-status-label">
      当前状态
    </text>

    <text class="status status-{{order.status}}">
      {{order.statusText}}
    </text>

  </view>

  <view class="status-buttons">

    <view
      wx:for="{{statusList}}"
      wx:key="key"
      class="status-button
        {{item.key === order.status ? 'current-status' : ''}}
        {{item.key === 'cancelled' && order.status === 'cancelled' ? 'current-cancel-status' : ''}}"
      data-status="{{item.key}}"
      bindtap="changeStatus"
    >
      {{item.name}}
    </view>

  </view>

</view>


<!-- 商品清单 -->

<view class="card">

  <view class="card-title">
    商品清单
  </view>

  <view
    wx:for="{{order.items}}"
    wx:key="cartId"
    class="item"
  >

    <view class="item-icon">
      {{item.emoji}}
    </view>

    <view class="item-info">

      <view class="item-name">
        {{item.name}}
      </view>

      <view class="item-desc">
        {{item.desc}}
      </view>

      <view class="item-bottom">

        <text>
          ¥{{item.price}}
        </text>

        <text class="quantity">
          × {{item.quantity}}
        </text>

      </view>

    </view>

    <view class="item-subtotal">
      ¥{{item.subtotal}}
    </view>

  </view>

  <view
    wx:if="{{!hasItems}}"
    class="empty-items"
  >
    暂无商品
  </view>

</view>


<!-- 金额明细 -->

<view class="card">

  <view class="card-title">
    金额明细
  </view>

  <view class="price-row">
    <text>商品小计</text>
    <text>¥{{order.totalPrice}}</text>
  </view>

  <view class="price-row">

    <text>配送费</text>

    <text>
      {{order.deliveryFee === '0.00'
        ? '免配送费'
        : '¥' + order.deliveryFee}}
    </text>

  </view>

  <view class="divider"></view>

  <view class="total-row">

    <text>
      实付金额
    </text>

    <text class="total-price">
      ¥{{order.finalPrice}}
    </text>

  </view>

</view>


<view class="count-tip">
  共 {{order.totalCount}} 件商品
</view>

</view>